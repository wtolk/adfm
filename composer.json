{
    "name": "wtolk/adfm",
    "description": "cms based on Laravel",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "wtolk.ru",
            "email": "web@wtolk.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "Wtolk\\Adfm\\": "src/",
            "Wtolk\\Adfm\\Database\\Seeders\\": "src/database/seeders/",
            "Wtolk\\Adfm\\Database\\Factories\\": "src/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wtolk\\Adfm\\Providers\\AdfmServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "wtolk/crud": "*",
        "ajthinking/archetype": "*",
        "jackiedo/dotenv-editor": "*",
        "laravel/fortify": "*",
        "league/glide": "^3.0.1",
        "ralouphie/mimey": "*",
        "spatie/laravel-permission": "*",
        "league/flysystem-aws-s3-v3": "^3.29",
        "kint-php/kint": "*",
        "spatie/laravel-honeypot": "*",
        "spatie/valuestore": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Wtolk\\Adfm\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
